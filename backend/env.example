# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# JWT Secret (for authentication) - Generate a strong secret for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Key (for API key authentication)
API_KEY=your-api-key-here

# Database Configuration
# PostgreSQL (recommended for production)
DATABASE_URL="postgresql://username:password@localhost:5432/fullstack_boilerplate?schema=public"

# Shadow Database URL (for migrations - optional, Prisma will create one if not provided)
# SHADOW_DATABASE_URL="postgresql://username:password@localhost:5432/fullstack_boilerplate_shadow?schema=public"

# SQLite (for development/testing)
# DATABASE_URL="file:./dev.db"

# MySQL (alternative)
# DATABASE_URL="mysql://username:password@localhost:3306/fullstack_boilerplate"

# MongoDB (if using MongoDB with Prisma)
# DATABASE_URL="mongodb://username:password@localhost:27017/fullstack_boilerplate"

# Database Pool Configuration
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Prisma Configuration
PRISMA_LOG_LEVEL=info
PRISMA_CLIENT_ENGINE_TYPE=binary

# API Keys (add your external service API keys here)
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG... 